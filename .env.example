# ---- Hindsight (https://github.com/vectorize-io/hindsight) ----
# Mode can be 'cloud' (https://api.hindsight.vectorize.io) or 'self_hosted' (http://localhost:8888)
HINDSIGHT_MODE=cloud
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your-hindsight-api-key-here
HINDSIGHT_BANK_PREFIX=cs-
HINDSIGHT_SHARED_KB_BANK=support-kb

# ---- RocketRide Server (https://github.com/rocketride-org/rocketride-server) ----
ROCKETRIDE_ENABLED=false
ROCKETRIDE_SERVER_URL=http://localhost:8080
ROCKETRIDE_PIPELINE_PATH=pipelines/support_agent.pipe

# ---- HydraDB Graph Database (https://github.com/hydra-db/hydradb) ----
HYDRADB_ENABLED=false
HYDRADB_HTTP_URL=http://localhost:8443
HYDRADB_BOLT_URL=bolt://localhost:7687
HYDRADB_TOKEN=hydradb-secret-token
HYDRADB_NAMESPACE=paynest-support

# ---- LLM (Groq) ----
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-20b

# ---- App ----
SESSION_SECRET=generate-a-long-random-string
DATABASE_URL=sqlite:///./data/app.db
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:8000
